# --- Site identity ---
# On Vercel this can stay empty: the code falls back to
# VERCEL_PROJECT_PRODUCTION_URL (your stable *.vercel.app domain), which Vercel
# injects automatically. Set it explicitly once you own a custom domain, and
# set it in the Vercel project env vars too, not just locally.
# Locally, leaving it empty means canonicals point at localhost — expected.
NEXT_PUBLIC_SITE_URL=

# --- Contact form (Resend) ---
# Required. https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact form submissions.
EMAIL_TO=you@example.com
# Sender address. Must be on a domain verified in Resend, otherwise Resend only
# delivers to the account owner's own address.
RESEND_FROM=portfolio@jagdishodedara.com

# --- Optional: GitHub enrichment ---
# Read-only token (no scopes needed for public repos). Without it the API is
# capped at 60 requests/hour per IP, which a cold build can exhaust.
GITHUB_TOKEN=

# --- Optional: analytics ---
# Cloudflare Web Analytics token. Cookieless, free, no consent banner needed.
# Cloudflare dashboard -> Analytics & Logs -> Web Analytics -> Add a site.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Optional: Google Search Console ---
# The content value from the "HTML tag" verification method.
GOOGLE_SITE_VERIFICATION=
